+                                                SEEDSIGNER_TTF_CACHE_SIZE);
+    if (!cjk) return base;
+    Entry &entry = cache[cache_count++];
+    entry.base = base;
+    entry.font = *base;          // shallow copy: same glyph data, own fallback pointer
+    entry.font.fallback = cjk;
+    return &entry.font;
+#else
+    return base;
+#endif
+}
