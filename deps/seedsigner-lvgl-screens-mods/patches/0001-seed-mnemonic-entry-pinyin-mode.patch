+// screen may reference it. Without tiny_ttf it degrades to the plain candidate font.
+static const lv_font_t *seed_mnemonic_entry_cjk_candidate_font() {
+    const lv_font_t *base = &CANDIDATE_FONT;
+#if LV_USE_TINY_TTF
+    struct Entry { const lv_font_t *base; lv_font_t font; };
+    static Entry cache[3];
+    static int cache_count = 0;
+    for (int i = 0; i < cache_count; ++i) {
+        if (cache[i].base == base) return &cache[i].font;
+    }
+    if (cache_count >= (int)(sizeof(cache) / sizeof(cache[0]))) return base;
+    // ~90% of the Latin line height keeps the (taller) CJK glyph boxes inside the
+    // candidate rows, whose line metrics come from the primary (Latin) font.
+    const int32_t cjk_px = (int32_t)lv_font_get_line_height(base) * 9 / 10;
+    lv_font_t *cjk = lv_tiny_ttf_create_data_ex(bip39_zh_subset_ttf, bip39_zh_subset_ttf_len,
